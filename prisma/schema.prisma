generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  firebaseUid String   @unique
  email       String   @unique
  name        String?
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  studyPlan     StudyPlan?
  subjects      Subject[]
  topics        Topic[]
  tasks         Task[]
  studySessions StudySession[]
  planStarts    DailyPlanStart[]
  applications  JobApplication[]
  notes         Note[]
  aiUsage       AiUsage[]
}

model StudyPlan {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  longTermDeadline        DateTime
  preparationDeadline     DateTime
  dailyStudyTargetMinutes Int      @default(180)
  /// Only the birth date is stored; the age-limit date (birth date + ageLimitYears) is calculated when shown.
  dateOfBirth             DateTime?
  ageLimitYears           Int      @default(34)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model Subject {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topics        Topic[]
  tasks         Task[]
  studySessions StudySession[]

  @@unique([userId, name])
  @@index([userId])
}

model Topic {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Topic?   @relation("TopicTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Topic[]  @relation("TopicTree")
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks         Task[]
  studySessions StudySession[]

  @@index([userId])
  @@index([subjectId])
  @@index([parentId])
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  FINISHED
  REVISION
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model Task {
  id               String       @id @default(cuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId        String?
  subject          Subject?     @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topicId          String?
  topic            Topic?       @relation(fields: [topicId], references: [id], onDelete: SetNull)
  title            String
  description      String?
  estimatedMinutes Int          @default(30)
  dueDate          DateTime?
  priority         TaskPriority @default(MEDIUM)
  status           TaskStatus   @default(NOT_STARTED)
  /// Finished (or "Revision") tasks are revised again and again; this counts how many times.
  timesRevised     Int          @default(0)
  lastRevisedAt    DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([userId])
  @@index([userId, dueDate])
  @@index([userId, status])
  @@index([createdAt])
}

model StudySession {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId       String?
  subject         Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topicId         String?
  topic           Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)
  startedAt       DateTime
  endedAt         DateTime
  durationSeconds Int
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([userId, startedAt])
  @@index([createdAt])
}



/// One row per day the user pressed "Start Today's Plan". Opening or refreshing the app never creates one.
model DailyPlanStart {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Start of the day in the app timezone.
  date      DateTime
  startedAt DateTime @default(now())

  @@unique([userId, date])
}

enum JobSector {
  GOVERNMENT
  NON_GOVERNMENT
}

enum ApplicationStatus {
  WISHLIST
  APPLIED
  EXAM
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

model JobApplication {
  id           String            @id @default(cuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Circular / job title, e.g. "Bangladesh Bank Officer (General) recruitment 2026".
  title        String
  organization String
  location     String?
  /// One circular can cover several posts; every post applied for is listed here.
  posts        String[]          @default([])
  sector       JobSector
  status       ApplicationStatus @default(APPLIED)
  appliedAt    DateTime?
  /// Last date to apply (from the circular).
  deadline     DateTime?
  /// Next exam or interview date.
  examDate     DateTime?
  /// User ID / roll / reference number from the application portal.
  reference    String?
  link         String?
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([userId])
  @@index([userId, status])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  /// Rich text from the Quill editor, sanitized to an allowlist of tags on save (no images).
  content   String   @default("")
  /// Tag-free copy of `content`, for search and list previews.
  plainText String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

/// One row per AI API call (each model attempt), for the AI usage page.
model AiUsage {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Which part of the app called the AI: assistant, answer, note_writer…
  feature      String
  model        String
  /// ok, error, rate_limited, overloaded, timeout
  status       String
  httpStatus   Int?
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  totalTokens  Int      @default(0)
  latencyMs    Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}
