generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String        @id @default(cuid())
  firebaseUid      String        @unique
  email            String        @unique
  name             String?
  image            String?
  /// Bangladesh mobile as +8801XXXXXXXXX (src/lib/phone.ts). Private: only the user and the super admin see it.
  phone            String?
  /// Set when the user saves their profile; sign-in then stops replacing `name` with the Google name.
  profileUpdatedAt DateTime?
  /// USER by default. Only the super admin (a fixed email, see src/server/roles.ts) can change roles.
  role             UserRole      @default(USER)
  /// What an ADMIN (staff) may do: billing, customers, question_bank, vocabulary, staff
  /// (src/lib/staff.ts). The super admin can do everything; a USER nothing.
  staffPermissions String[]      @default([])
  /// BLOCKED: the super admin shut the account; the user sees only a "blocked" notice.
  status           AccountStatus @default(ACTIVE)
  /// The super admin paused this user's AI (the plan's days keep running); the rest of the app works.
  aiPaused         Boolean       @default(false)
  /// Whether this user may use the AI. New users start without it and ask an admin; admins always have it.
  aiAccess         AiAccess      @default(NONE)
  aiRequestedAt    DateTime?
  /// Most AI tokens this user may use in total; null = no limit. Admins are never limited.
  aiTokenLimit     Int?          @default(1000000)
  /// The floating dock's shortcuts after the fixed AI chat, in order (src/lib/quick-items.ts): a tool
  /// ("calendar", "calculator") or a page path. Five at most; the user picks them on /settings.
  quickItems       String[]      @default(["calendar", "calculator"])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  studyPlan              StudyPlan?
  subjects               Subject[]
  topics                 Topic[]
  tasks                  Task[]
  studySessions          StudySession[]
  planStarts             DailyPlanStart[]
  questionSets           QuestionSet[]
  testAttempts           TestAttempt[]
  shortQuestionSets      ShortQuestionSet[]
  shortTestAttempts      ShortTestAttempt[]
  confusions             Confusion[]
  studyVideos            StudyVideo[]
  verbEntries            VerbEntry[]
  affixEntries           AffixEntry[]
  nounEntries            NounEntry[]
  vocabLearned           VocabLearned[]
  vocabExams             VocabExam[]
  // Collaboration (docs/collaboration-plan.md)
  friendRequestsSent     FriendRequest[]       @relation("FriendRequestFrom")
  friendRequestsReceived FriendRequest[]       @relation("FriendRequestTo")
  friendshipsA           Friendship[]          @relation("FriendshipA")
  friendshipsB           Friendship[]          @relation("FriendshipB")
  sharesSent             ShareRequest[]        @relation("ShareSender")
  sharesReceived         ShareRequest[]        @relation("ShareRecipient")
  notifications          Notification[]        @relation("NotificationUser")
  notificationsCaused    Notification[]        @relation("NotificationActor")
  conversationsA         Conversation[]        @relation("ConversationA")
  conversationsB         Conversation[]        @relation("ConversationB")
  messagesSent           Message[]
  // Group chat (docs/profile-and-group-chat-plan.md §2)
  groupMemberships       ChatGroupMember[]
  groupMessagesSent      GroupMessage[]
  applications           JobApplication[]
  notes                  Note[]
  aiUsage                AiUsage[]
  aiUses                 AiUse[]
  payments               Payment[]
  entitlements           Entitlement[]
  devices                UserDevice[]
  bankUnlocks            BankSetUnlock[]
  /// Affiliate (docs/affiliate-plan.md): this user's code in links (`?ref=CODE`), made when first needed.
  affiliateCode          String?               @unique
  /// Chosen as an affiliate by an admin (needed unless the program is open to everyone).
  affiliateActive        Boolean               @default(false)
  /// Where cash commission is sent (bKash/Nagad number), given by the affiliate.
  affiliatePayoutNumber  String?
  /// The affiliate whose link brought this user (first one wins, kept for good).
  referredById           String?
  referredBy             User?                 @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referredAt             DateTime?
  referrals              User[]                @relation("Referrals")
  affiliateClicks        AffiliateClick[]
  commissionsEarned      AffiliateCommission[] @relation("CommissionAffiliate")
  commissionsBrought     AffiliateCommission[] @relation("CommissionCustomer")
  affiliatePayouts       AffiliatePayout[]
  activeTimer            ActiveTimer?
}

model StudyPlan {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  longTermDeadline        DateTime
  preparationDeadline     DateTime
  dailyStudyTargetMinutes Int       @default(180)
  /// Only the birth date is stored; the age-limit date (birth date + ageLimitYears) is calculated when shown.
  dateOfBirth             DateTime?
  ageLimitYears           Int       @default(34)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

model Subject {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  /// Order on the Subjects page (drag and drop); lower first.
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topics            Topic[]
  tasks             Task[]
  notes             Note[]
  questionSets      QuestionSet[]
  shortQuestionSets ShortQuestionSet[]
  confusions        Confusion[]
  studyVideos       StudyVideo[]
  studySessions     StudySession[]

  @@unique([userId, name])
  @@index([userId])
}

model Topic {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Topic?   @relation("TopicTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Topic[]  @relation("TopicTree")
  name      String
  /// Order among topics with the same parent (drag and drop); lower first.
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks             Task[]
  notes             Note[]
  studySessions     StudySession[]
  questionSets      QuestionSet[]
  shortQuestionSets ShortQuestionSet[]
  confusions        Confusion[]

  @@index([userId])
  @@index([subjectId])
  @@index([parentId])
}

enum AccountStatus {
  ACTIVE
  BLOCKED
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

/// No longer used by the app (AI access now comes from plans); kept so old data stays readable.
enum AiAccess {
  /// Never asked.
  NONE
  /// Asked an admin; waiting.
  REQUESTED
  APPROVED
  /// Turned off by an admin.
  DISABLED
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  FINISHED
  REVISION
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model Task {
  id               String       @id @default(cuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId        String?
  subject          Subject?     @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topicId          String?
  topic            Topic?       @relation(fields: [topicId], references: [id], onDelete: SetNull)
  title            String
  description      String?
  estimatedMinutes Int          @default(30)
  dueDate          DateTime?
  priority         TaskPriority @default(MEDIUM)
  status           TaskStatus   @default(NOT_STARTED)
  /// The user's own order on the Tasks page (drag and drop); lower first.
  position         Int          @default(0)
  /// Finished (or "Revision") tasks are revised again and again; this counts how many times.
  timesRevised     Int          @default(0)
  lastRevisedAt    DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  notes            TaskNote[]

  @@index([userId])
  @@index([userId, dueDate])
  @@index([userId, status])
  @@index([createdAt])
}

/// A browser or phone this user is signed in on (cookie "prep_device" holds the id). At most two
/// at a time (src/server/devices.ts); a third sign-in must remove one. Deleting the row signs that
/// device out on its next request.
model UserDevice {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "Chrome · Android", from the user agent, to tell the devices apart.
  label      String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

/// The study timer running for this user, shared by all their devices: one at a time, so a second
/// device shows this one instead of starting another. Gone when the session is saved or cancelled.
model ActiveTimer {
  userId        String    @id
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// When the running stretch began (null while paused); time before it is in accumulatedMs.
  startedAt     DateTime?
  accumulatedMs Int       @default(0)
  paused        Boolean   @default(false)
  label         String    @default("")
  taskId        String    @default("")
  subjectId     String    @default("")
  topicId       String    @default("")
  targetMinutes Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model StudySession {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId       String?
  subject         Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topicId         String?
  topic           Topic?   @relation(fields: [topicId], references: [id], onDelete: SetNull)
  startedAt       DateTime
  endedAt         DateTime
  durationSeconds Int
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([userId, startedAt])
  @@index([createdAt])
}

/// One row per day the user pressed "Start Today's Plan". Opening or refreshing the app never creates one.
model DailyPlanStart {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Start of the day in the app timezone.
  date      DateTime
  startedAt DateTime @default(now())

  @@unique([userId, date])
}

enum JobSector {
  GOVERNMENT
  NON_GOVERNMENT
}

enum ApplicationStatus {
  WISHLIST
  APPLIED
  EXAM
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

model JobApplication {
  id           String            @id @default(cuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Circular / job title, e.g. "Bangladesh Bank Officer (General) recruitment 2026".
  title        String
  organization String
  location     String?
  /// One circular can cover several posts; every post applied for is listed here.
  posts        String[]          @default([])
  sector       JobSector
  status       ApplicationStatus @default(APPLIED)
  appliedAt    DateTime?
  /// Last date to apply (from the circular).
  deadline     DateTime?
  /// Next exam or interview date.
  examDate     DateTime?
  /// User ID from the application portal.
  reference    String?
  /// Roll number (usually on the admit card).
  roll         String?
  /// Portal password, kept as plain text so the user can look it up here later.
  password     String?
  link         String?
  /// Everything else from the applicant copy, as sanitized Quill HTML (older rows may be plain text).
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([userId])
  @@index([userId, status])
}

model Note {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  /// Rich text from the Quill editor, sanitized to an allowlist of tags on save (no images).
  content   String     @default("")
  /// Tag-free copy of `content`, for search and list previews.
  plainText String     @default("")
  subjectId String?
  subject   Subject?   @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topicId   String?
  topic     Topic?     @relation(fields: [topicId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  tasks     TaskNote[]

  @@index([userId, updatedAt])
  @@index([subjectId])
  @@index([topicId])
}

/// A note attached to a task (any note, any number of tasks).
model TaskNote {
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([taskId, noteId])
  @@index([noteId])
}

/// One row per AI API call (each model attempt), for the AI usage page.
model AiUsage {
  id           String   @id @default(cuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Which part of the app called the AI: assistant, answer, note_writer…
  feature      String
  model        String
  /// ok, error, rate_limited, overloaded, timeout
  status       String
  httpStatus   Int?
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  totalTokens  Int      @default(0)
  latencyMs    Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

/// Money the owner put on the OpenAI account (or the balance OpenAI showed on a day). Balance left
/// = all of these − what OpenAI's Costs API says was spent since the first one. Super admin only.
model AiCredit {
  id          String   @id @default(cuid())
  /// US cents, so sums stay exact.
  amountCents Int
  /// The day the money was added; spending is counted from the earliest one.
  addedAt     DateTime
  note        String?
  createdAt   DateTime @default(now())

  @@index([addedAt])
}

// ---------- Plans & payments ----------

enum PlanType {
  STUDENT
  PROFESSIONAL
}

enum PaymentMethod {
  BKASH
  NAGAD
  /// Paid online through the SSLCommerz gateway (card, mobile banking); approved by its validation.
  SSLCOMMERZ
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A package on sale. Price, days and tokens are edited by admins; nothing is hardcoded in the app.
model PlanPackage {
  id           String    @id @default(cuid())
  planType     PlanType
  /// Shown to users, e.g. "15 Days", "1 Month", "Premium".
  name         String
  durationDays Int
  tokens       Int
  /// Current price in taka. A payment keeps its own copy, so changing this never changes old payments.
  priceBdt     Int
  active       Boolean   @default(true)
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  payments     Payment[]

  @@index([planType, sortOrder])
}

/// Where users send money (one number per method), set by admins.
model PaymentAccount {
  method      PaymentMethod @id
  number      String
  /// e.g. "Personal" — tells the user to use Send Money.
  accountType String        @default("Personal")
  enabled     Boolean       @default(true)
  updatedAt   DateTime      @updatedAt
}

/// One purchase request. Everything about the package is copied in at submit time and never changes.
model Payment {
  id            String               @id @default(cuid())
  userId        String
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId     String?
  package       PlanPackage?         @relation(fields: [packageId], references: [id], onDelete: SetNull)
  planType      PlanType
  packageName   String
  durationDays  Int
  tokens        Int
  /// The price at the moment the user submitted, kept forever.
  amountBdt     Int
  method        PaymentMethod
  senderNumber  String
  transactionId String
  status        PaymentStatus        @default(PENDING)
  /// "page" or "chat" — where the user bought it.
  source        String               @default("page")
  /// Exams bought (ExamTrack ids, as they were at purchase). Empty for old package payments.
  trackIds      String[]             @default([])
  /// Bought as the "all exams" plan.
  allTracks     Boolean              @default(false)
  /// How the price was made up at purchase (system, AI, exams, discounts, days), for the record.
  breakdown     Json?
  /// Affiliate credit taken off the price (credit payout mode); amountBdt is what was left to pay.
  creditUsedBdt Int                  @default(0)
  adminNote     String?
  reviewedAt    DateTime?
  reviewedBy    String?
  createdAt     DateTime             @default(now())
  entitlement   Entitlement?
  commission    AffiliateCommission?

  /// A transaction ID can be used only once per method.
  @@unique([method, transactionId])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/// The benefit from one approved payment: its days, its AI tokens (they add up across purchases),
/// and which exams' paid content it opens. Old package purchases have allTracks with no trackIds,
/// which means every exam (docs/subscription-plan.md).
model Entitlement {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentId  String    @unique
  payment    Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  tokens     Int
  trackIds   String[]  @default([])
  allTracks  Boolean
  startsAt   DateTime
  endsAt     DateTime
  /// Set when an admin cancelled the subscription: the remaining days and use were taken away then.
  canceledAt DateTime?
  canceledBy String?
  createdAt  DateTime  @default(now())

  @@index([userId, endsAt])
}

/// Prices that apply to every plan. One row (id "default"); the super admin edits it.
/// Unused since Gemini was removed (2026-10-19); kept so the schema matches the database. It may
/// hold the old encrypted Gemini key. Dropping it needs a migration (ask the owner first).
model AiSettings {
  id          String   @id @default("default")
  /// "openai" or "gemini"; the other one (when it has a key) answers if this one fails.
  provider    String   @default("openai")
  /// The Gemini API key, encrypted (AES-256-GCM, src/server/secret-box.ts) — never sent to a page.
  geminiKey   String?
  /// The Gemini model; empty = the default in src/server/assistant/gemini.ts (gemini-3.8-flash).
  geminiModel String?
  updatedAt   DateTime @updatedAt
}

model PricingSettings {
  id                   String   @id @default("default")
  /// The app itself (system features), per 30 days.
  systemPriceBdt       Int
  /// Off the exam part of the "all exams" plan only (never off System or AI).
  allTracksDiscountPct Int
  /// SSLCommerz shown to customers (it also needs its env vars).
  gatewayEnabled       Boolean  @default(false)
  updatedAt            DateTime @updatedAt
}

/// The two AI levels a plan comes with. Quotas are read live, so changing them applies at once.
model AiTier {
  planType          PlanType @id
  name              String
  /// Per 30 days.
  priceBdt          Int
  /// Cost guard: AI tokens per 30 days, copied onto each payment.
  tokensPerMonth    Int
  messagesPerDay    Int
  scansPerDay       Int
  suggestionsPerDay Int
  active            Boolean  @default(true)
  updatedAt         DateTime @updatedAt
}

/// An exam a plan can be bought for (the spec's "Subject"): opens that exam's paid question-bank
/// content. `bankExam` links it to the bank; a track without one has no bank content yet.
model ExamTrack {
  id        String    @id @default(cuid())
  name      String
  /// Per 30 days.
  priceBdt  Int
  bankExam  BankExam? @unique
  active    Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// How long a plan runs. Prices are per 30 days; longer ones can have a discount.
model PlanDuration {
  id          String   @id @default(cuid())
  days        Int      @unique
  label       String
  discountPct Int      @default(0)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  updatedAt   DateTime @updatedAt
}

/// One allowed AI action, for the per-day limits: "message", "scan" or "suggestion". `ref` ties
/// several calls of one action together (a photo is read twice), so it counts once.
model AiUse {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  ref       String?
  createdAt DateTime @default(now())

  @@index([userId, kind, createdAt])
  @@index([userId, ref])
}

enum QuestionSetStatus {
  TODO
  DOING
  TESTING
  DONE
}

/// Preliminary: MCQs on one topic of a subject, studied (DOING, answers shown) then tested (TESTING, answers hidden).
model QuestionSet {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId   String?
  subject     Subject?          @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  /// Optional place in the owner's subject → topic tree (used to file and filter it).
  topicId     String?
  topic       Topic?            @relation(fields: [topicId], references: [id], onDelete: SetNull)
  topicName   String
  /// The day this set is planned for (a date; stored at midnight Asia/Dhaka).
  date        DateTime
  /// Short note shown on its question paper (`/preliminary/[id]/paper`); set when built from picked questions.
  description String?
  status      QuestionSetStatus @default(TODO)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  questions   Question[]
  attempts    TestAttempt[]
  /// Set when this set was sent from the Question Bank; one copy per user per bank set.
  bankSetId   String?
  bankSet     BankSet?          @relation(fields: [bankSetId], references: [id], onDelete: SetNull)
  /// Sent from the Question Bank (a past-year set or a chapter's MCQs). Counts toward the "two at a
  /// time until 60%" limit (src/server/bank-slots.ts) — kept even if the bank set is later removed.
  fromBank    Boolean           @default(false)

  @@unique([userId, bankSetId])
  @@index([userId, status])
  @@index([subjectId])
  @@index([topicId])
}

model Question {
  id           String      @id @default(cuid())
  setId        String
  set          QuestionSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  position     Int         @default(0)
  text         String
  /// Four options (ক খ গ ঘ), or five (… ঙ) for questions from the Question Bank.
  options      String[]
  /// Which option is right (0-based). Never sent to the page during a test.
  correctIndex Int
  /// From the Question Bank (or kept through edits); hidden during a test like the answer.
  solution     String?
  explanation  String?

  @@index([setId, position])
}

/// One finished test. Keeps a copy of the questions as they were, so the result never changes later.
model TestAttempt {
  id          String      @id @default(cuid())
  setId       String
  set         QuestionSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  total       Int
  correct     Int
  /// [{ text, options, correctIndex, chosen }] — chosen is -1 when left blank.
  details     Json
  submittedAt DateTime    @default(now())

  @@index([setId, submittedAt])
  @@index([userId])
}

/// Short Question: question–answer pairs on one topic, with the same Todo → Doing → Testing → Done flow as Preliminary.
model ShortQuestionSet {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId String?
  subject   Subject?           @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  /// Optional place in the owner's subject → topic tree (used to file and filter it).
  topicId   String?
  topic     Topic?             @relation(fields: [topicId], references: [id], onDelete: SetNull)
  topicName String
  /// The day this set is planned for (a date; stored at midnight Asia/Dhaka).
  date      DateTime
  status    QuestionSetStatus  @default(TODO)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  questions ShortQuestion[]
  attempts  ShortTestAttempt[]
  /// Sent from a Question Bank chapter; counts toward the "two at a time until 60%" limit.
  fromBank  Boolean            @default(false)

  @@index([userId, status])
  @@index([subjectId])
  @@index([topicId])
}

model ShortQuestion {
  id       String           @id @default(cuid())
  setId    String
  set      ShortQuestionSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  position Int              @default(0)
  text     String
  /// Never sent to the page during a test.
  answer   String

  @@index([setId, position])
}

/// One finished test, self-marked: a copy of the questions as they were, with what was written.
model ShortTestAttempt {
  id          String           @id @default(cuid())
  setId       String
  set         ShortQuestionSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  total       Int
  /// How many are marked right so far.
  correct     Int
  /// [{ text, answer, given, right }] — right is null until marked.
  details     Json
  submittedAt DateTime         @default(now())

  @@index([setId, submittedAt])
  @@index([userId])
}

enum ConfusionStatus {
  CONFUSION
  CLEAR
}

/// Confusion: a doubt noted down to ask in class, then marked Clear with what was learned.
/// A YouTube video a user saved to watch inside the app, away from YouTube's suggestions. Free users
/// keep up to 5; a running plan (or admin) removes the limit. Only the video id is stored.
model StudyVideo {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  /// The 11-character YouTube video id.
  videoId   String
  title     String
  channel   String?
  createdAt DateTime @default(now())

  @@unique([userId, videoId])
  @@index([userId, createdAt])
  @@index([subjectId])
}

model Confusion {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId     String?
  subject       Subject?        @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  /// Optional place in the owner's topic tree. `topic` (free text) is kept for older entries.
  topicId       String?
  topicRef      Topic?          @relation(fields: [topicId], references: [id], onDelete: SetNull)
  topic         String?
  text          String
  /// What made it clear (the teacher's explanation), written when it is marked Clear.
  clarification String?
  status        ConfusionStatus @default(CONFUSION)
  clearedAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId, status])
  @@index([subjectId])
  @@index([topicId])
}

/// Vocabulary, shared by everyone: one verb's forms and its meaning. Built-in rows come from
/// prisma/seed-vocabulary.ts and have no userId; rows an admin adds keep who added them.
model VerbEntry {
  id             String   @id @default(cuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  present        String
  past           String
  pastParticiple String
  meaning        String
  /// The word explained in Bangla (meaning, use, examples), written with AI by staff; everyone reads it.
  explanation    String?
  /// Six example sentences with their Bangla, `[{ form, en, bn }]` (src/lib/vocabulary/sentences.ts),
  /// written with AI by staff; paid users read them.
  sentences      Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, present])
}

enum AffixKind {
  PREFIX
  SUFFIX
}

/// Vocabulary: a prefix or suffix with its Bangla meaning and an example word, written by the user.
model AffixEntry {
  id          String    @id @default(cuid())
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind        AffixKind
  affix       String
  meaning     String
  /// An example word and its meaning, e.g. "unhappy — অসুখী".
  example     String    @default("")
  /// Explained in Bangla with AI by staff (see VerbEntry.explanation).
  explanation String?
  /// Six example sentences with their Bangla, `[{ form, en, bn }]` (src/lib/vocabulary/sentences.ts),
  /// written with AI by staff; paid users read them.
  sentences   Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, kind])
}

/// Vocabulary: a noun's singular and plural with its Bangla meaning, written by the user.
/// "-" for singular means it is used only in the plural; "-" for plural means it has none.
model NounEntry {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  singular    String
  plural      String
  meaning     String
  /// The noun is a person, so its Bangla plural takes "-রা" (শিশুরা) rather than "-গুলো".
  person      Boolean  @default(false)
  /// Explained in Bangla with AI by staff (see VerbEntry.explanation).
  explanation String?
  /// Six example sentences with their Bangla, `[{ form, en, bn }]` (src/lib/vocabulary/sentences.ts),
  /// written with AI by staff; paid users read them.
  sentences   Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

/// The three vocabulary exams: drag the other form, drag the meaning, type the spelling.
enum VocabExamType {
  FORMS
  MEANING
  SPELLING
}

/// One finished vocabulary exam on a user's current set of words (revision exams are not stored).
model VocabExam {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  batch     Int
  type      VocabExamType
  score     Int
  total     Int
  createdAt DateTime      @default(now())

  @@index([userId, batch])
}

enum VocabKind {
  VERB
  NOUN
  AFFIX
  PERSON
}

/// A vocabulary row one user has marked as learned. entryId is the VerbEntry/NounEntry/AffixEntry id,
/// or a fixed key for the Person reference table.
model VocabLearned {
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      VocabKind
  entryId   String
  createdAt DateTime  @default(now())
  /// Which set of 50 the word was learned in (src/lib/vocabulary/exam.ts): the next set opens only
  /// after the three exams on this one are passed.
  batch     Int       @default(1)
  /// Answered wrong in the last exam that asked it, so it waits in "ভুলগুলো" for revision; cleared
  /// when it is answered right.
  missedAt  DateTime?

  @@id([userId, kind, entryId])
}

/**
 * ---------- Collaboration: friends, sharing, notifications, chat (docs/collaboration-plan.md) ----------
 */

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum ShareItemType {
  NOTE
  TASK
  PRELIMINARY_SET
  SHORT_QUESTION_SET
}

enum NotificationType {
  FRIEND_REQUEST
  FRIEND_ACCEPTED
  FRIEND_REJECTED
  SHARE_REQUEST
  SHARE_ACCEPTED
  SHARE_REJECTED
  GROUP_ADDED
}

/// A friend request. History is kept; the migration adds a partial unique index so only one
/// PENDING request exists per unordered pair of users.
model FriendRequest {
  id          String        @id @default(cuid())
  fromId      String
  from        User          @relation("FriendRequestFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId        String
  to          User          @relation("FriendRequestTo", fields: [toId], references: [id], onDelete: Cascade)
  status      RequestStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  respondedAt DateTime?

  notifications Notification[]

  @@index([toId, status])
  @@index([fromId, status])
}

/// Two users who are friends, stored once per pair with userAId < userBId (a CHECK in the migration).
/// Friendship is what allows sharing and chatting.
model Friendship {
  userAId   String
  userA     User     @relation("FriendshipA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId   String
  userB     User     @relation("FriendshipB", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userAId, userBId])
  @@index([userBId])
}

/// One item offered to a friend. `payload` is a copy of the item frozen at send time (the original
/// may change or be deleted later); accepting creates the recipient's own item from it exactly once
/// and records it in `createdItemId`. A partial unique index stops duplicate PENDING shares.
model ShareRequest {
  id            String        @id @default(cuid())
  senderId      String
  sender        User          @relation("ShareSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId   String
  recipient     User          @relation("ShareRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  itemType      ShareItemType
  /// The sender's item at send time. No foreign key: it may be deleted later.
  sourceItemId  String
  title         String
  payload       Json
  status        RequestStatus @default(PENDING)
  createdItemId String?
  createdAt     DateTime      @default(now())
  respondedAt   DateTime?

  notifications Notification[]

  @@index([recipientId, status])
  @@index([senderId, status])
}

/// Something a user should know about (friend and share events). Chat messages are not notified
/// row by row; unread chat counts come from Message and Conversation.*LastReadAt.
model Notification {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  type            NotificationType
  actorId         String?
  actor           User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  friendRequestId String?
  friendRequest   FriendRequest?   @relation(fields: [friendRequestId], references: [id], onDelete: SetNull)
  shareRequestId  String?
  shareRequest    ShareRequest?    @relation(fields: [shareRequestId], references: [id], onDelete: SetNull)
  /// GROUP_ADDED: the group you were added to; gone with the group.
  groupId         String?
  group           ChatGroup?       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  readAt          DateTime?
  createdAt       DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

/// A one-to-one chat, one per pair with userAId < userBId (a CHECK in the migration). Each side's
/// last-read time gives its unread count. Kept after unfriending (read-only then).
model Conversation {
  id              String    @id @default(cuid())
  userAId         String
  userA           User      @relation("ConversationA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId         String
  userB           User      @relation("ConversationB", fields: [userBId], references: [id], onDelete: Cascade)
  userALastReadAt DateTime?
  userBLastReadAt DateTime?
  lastMessageAt   DateTime?
  createdAt       DateTime  @default(now())
  messages        Message[]

  @@unique([userAId, userBId])
  @@index([userBId])
}

/// A chat message: plain text only, always rendered as text (never HTML).
model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

/**
 * ---------- Group chat (docs/profile-and-group-chat-plan.md §2) ----------
 */

enum GroupRole {
  ADMIN
  MEMBER
}

enum GroupMessageKind {
  TEXT
  /// "X joined", "renamed to …": written by the server, shown centred.
  SYSTEM
}

/// A chat of 3–20 people. Separate from the 1:1 `Conversation`. Members are added from the adder's
/// friends; leaving or removal deletes the member row (no access to the history afterwards).
model ChatGroup {
  id            String            @id @default(cuid())
  name          String
  /// Who made it; kept as plain text so the group outlives that account.
  createdById   String
  lastMessageAt DateTime?
  createdAt     DateTime          @default(now())
  members       ChatGroupMember[]
  messages      GroupMessage[]
  notifications Notification[]
}

model ChatGroupMember {
  groupId    String
  group      ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       GroupRole @default(MEMBER)
  joinedAt   DateTime  @default(now())
  lastReadAt DateTime?

  @@id([groupId, userId])
  @@index([userId])
}

/// A group message: plain text only, always rendered as text (never HTML).
model GroupMessage {
  id        String           @id @default(cuid())
  groupId   String
  group     ChatGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// Null for SYSTEM lines, or after the sender's account is deleted.
  senderId  String?
  sender    User?            @relation(fields: [senderId], references: [id], onDelete: SetNull)
  kind      GroupMessageKind @default(TEXT)
  body      String
  createdAt DateTime         @default(now())

  @@index([groupId, createdAt])
}

/**
 * ---------- Question Bank (docs/question-bank-plan.md) ----------
 */

/// The three exam tabs of the Question Bank.
enum BankExam {
  BCS
  PRIMARY
  GRADE_11_20
}

/// A tab under "বিগত বছরের প্রশ্ন" (docs/question-bank-v2-plan.md): the three built-in exams, linked
/// to BankExam so their price stays the exam's track, and any an admin adds (exam null: any plan).
model BankCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  exam      BankExam? @unique
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  sets      BankSet[]
}

/// One past paper (or other session) in the shared bank, uploaded from a sheet or moved here by staff.
/// Users read it and send a copy to their own Preliminary; there is no status here.
model BankSet {
  id         String          @id @default(cuid())
  categoryId String
  category   BankCategory    @relation(fields: [categoryId], references: [id])
  /// Mirrors the category's exam (null for admin-added categories); the sheet upload finds sets by it.
  exam       BankExam?
  /// The sheet's "ধরন (Section)", e.g. "বিগত সালের প্রশ্ন".
  section    String
  /// The sheet's "সেশন/বিষয়", e.g. "গণপূর্ত অধিদপ্তর (2025)".
  name       String
  /// Read from the name when created; null shows under "অন্যান্য". Staff can change it.
  year       Int?
  /// Open to everyone, plan or not.
  free       Boolean         @default(false)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  questions  BankQuestion[]
  copies     QuestionSet[]
  unlocks    BankSetUnlock[]

  @@unique([categoryId, section, name])
  @@index([exam])
}

/// An MCQ in a past-year set or in a General chapter (exactly one of the two; a CHECK in SQL).
model BankQuestion {
  id           String       @id @default(cuid())
  setId        String?
  set          BankSet?     @relation(fields: [setId], references: [id], onDelete: Cascade)
  chapterId    String?
  chapter      BankChapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  /// The sheet's "ক্রম"; questions are shown in this order.
  serial       Int
  text         String
  /// 4 or 5 options (ক–ঘ, plus ঙ from "অতিরিক্ত অপশন").
  options      String[]
  correctIndex Int
  solution     String?
  explanation  String?
  /// The sheet's "সব উৎস", kept as written ("A › B ; C › D"); its subject decides where a copy lands.
  sources      String?
  /// Hash of the question and its options: the sheet has no ID, so this is how a re-upload finds
  /// the same question (and updates it) instead of adding it twice.
  fingerprint  String
  /// A chapter MCQ open without a plan (a past-year set is free or paid as a whole).
  free         Boolean      @default(false)
  /// Set when an admin edits the question or has AI clean it. A later upload of the sheet then leaves
  /// it alone (the sheet still holds the old text). The fingerprint stays the sheet's, so the same
  /// row is still recognised and never added twice.
  editedAt     DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([setId, fingerprint])
  @@unique([chapterId, fingerprint])
  @@index([setId, serial])
  @@index([chapterId, serial])
}

/// A past-year set a user without a plan chose to open (owner, 2026-10-16: any 3, kept for good).
model BankSetUnlock {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  setId     String
  set       BankSet  @relation(fields: [setId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, setId])
}

/// A subject of the General bank (shared; staff add them).
model BankSubject {
  id        String        @id @default(cuid())
  name      String        @unique
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  chapters  BankChapter[]
}

model BankChapter {
  id             String              @id @default(cuid())
  subjectId      String
  subject        BankSubject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name           String
  /// A line or two under the short name on the chapter's card (owner, 2026-10-17).
  description    String?
  sortOrder      Int                 @default(0)
  createdAt      DateTime            @default(now())
  articles       BankArticle[]
  questions      BankQuestion[]
  shortQuestions BankShortQuestion[]

  @@unique([subjectId, name])
}

/// A lesson written in the Quill editor (sanitized HTML). Free unless staff mark it paid.
model BankArticle {
  id        String      @id @default(cuid())
  chapterId String
  chapter   BankChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  title     String
  content   String
  free      Boolean     @default(true)
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([chapterId, sortOrder])
}

model BankShortQuestion {
  id          String      @id @default(cuid())
  chapterId   String
  chapter     BankChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  serial      Int         @default(0)
  question    String
  answer      String
  /// Hash of the question, so an upload doesn't add it twice to the chapter.
  fingerprint String
  free        Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([chapterId, fingerprint])
  @@index([chapterId, serial])
}

enum AffiliateCommissionMode {
  /// A share of what the customer paid.
  PERCENT
  /// A fixed amount per purchase.
  FIXED
}

enum AffiliatePayoutMode {
  /// Sent by the admin to the affiliate's bKash/Nagad, recorded as AffiliatePayout.
  CASH
  /// Taken off the affiliate's own plan purchases (Payment.creditUsedBdt).
  CREDIT
}

/// The affiliate program's rules (one row, id "default"); every choice is the super admin's.
model AffiliateSettings {
  id             String                  @id @default("default")
  enabled        Boolean                 @default(false)
  /// Everyone gets a link, or only users an admin made affiliates.
  openToAll      Boolean                 @default(false)
  commissionMode AffiliateCommissionMode @default(PERCENT)
  percent        Int                     @default(20)
  fixedBdt       Int                     @default(50)
  /// Every purchase of the customer earns, or only their first.
  recurring      Boolean                 @default(false)
  /// Days after a click within which signing up / buying ties the customer to the affiliate.
  windowDays     Int                     @default(30)
  payoutMode     AffiliatePayoutMode     @default(CASH)
  updatedAt      DateTime                @updatedAt
}

/// One visit through an affiliate link (counted once per browser per code).
model AffiliateClick {
  id          String   @id @default(cuid())
  affiliateId String
  affiliate   User     @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([affiliateId, createdAt])
}

/// Earned when a referred customer's payment is approved; amounts are copied in at that moment.
model AffiliateCommission {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   User      @relation("CommissionAffiliate", fields: [affiliateId], references: [id], onDelete: Cascade)
  customerId  String
  customer    User      @relation("CommissionCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  paymentId   String    @unique
  payment     Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  /// What the customer paid, and the rule applied ("20%", "৳50").
  basisBdt    Int
  rule        String
  amountBdt   Int
  /// Voided by an admin (a refund or abuse); it no longer counts.
  canceledAt  DateTime?
  canceledBy  String?
  createdAt   DateTime  @default(now())

  @@index([affiliateId, createdAt])
}

/// Cash sent to an affiliate by an admin.
model AffiliatePayout {
  id          String   @id @default(cuid())
  affiliateId String
  affiliate   User     @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  amountBdt   Int
  note        String?
  paidBy      String
  createdAt   DateTime @default(now())

  @@index([affiliateId, createdAt])
}
